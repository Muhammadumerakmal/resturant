{
  "name": "resturant-umer-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run db:generate -w @repo/db",
    "db:migrate": "npm run db:migrate -w @repo/db",
    "db:seed": "npm run db:seed -w @repo/db",
    "db:triggers": "npm run db:triggers -w @repo/db",
    "db:studio": "npm run db:studio -w @repo/db",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
